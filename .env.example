# Copie para .env. Nada aqui é segredo real: são valores de desenvolvimento local.
DATABASE_URL="postgresql://mapa:mapa_dev@localhost:5433/mapa?schema=public"
# Chave de assinatura da sessão (troque por qualquer string longa aleatória)
SESSION_SECRET="troque-por-uma-string-aleatoria-com-32-caracteres-ou-mais"
# Senha do consultor criado pelo seed
SEED_CONSULTANT_PASSWORD="mapa-demo-local"
# Resumo por IA (opcional). Sem chave, o MockProvider é usado.
SUMMARY_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
